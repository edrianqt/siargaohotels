# Copy to .env and fill in. Flask loads .env automatically when python-dotenv is installed.
FLASK_APP=wsgi
SECRET_KEY=change-this-to-a-long-random-string
# DATABASE_PATH=/var/www/siargaohotels/instance/siargao.sqlite3
SESSION_COOKIE_SECURE=1

# Booking / contact notifications (optional — without these, emails are only logged)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@siargaohotels.ph
MAIL_PASSWORD=app-password-here
MAIL_FROM=info@siargaohotels.ph
ADMIN_NOTIFY=info@siargaohotels.ph
